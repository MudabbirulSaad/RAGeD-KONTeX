# LLM Backend Configuration
LLM_BACKEND=ollama

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
OLLAMA_LLM_MODEL=gpt-oss:20b

# LiteLLM Configuration (only needed if LLM_BACKEND=litellm)
# Examples:
#   OpenAI: openai/gpt-4
#   Anthropic: anthropic/claude-3-opus-20240229
#   Google: gemini/gemini-pro
#   OpenRouter: openrouter/google/gemini-2.5-flash
LITELLM_MODEL=openai/gpt-4
LITELLM_API_KEY=your-api-key-here
LITELLM_API_BASE=
# For OpenRouter, set: LITELLM_API_BASE=https://openrouter.ai/api/v1

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Embedding Configuration
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=32

# Chunking Configuration
CHUNK_SIZE=1024
CHUNK_OVERLAP_PERCENT=10
MIN_CHUNK_SIZE=512

# Retrieval Configuration
TOP_K_RESULTS=10
SEARCH_SCORE_THRESHOLD=0.3

# File Context Reconstruction Configuration
ENABLE_FILE_RECONSTRUCTION=true
CONTEXT_LINES_BEFORE_AFTER=10
MAX_LINES_PER_FILE=100

# LLM Configuration
LLM_CONTEXT_WINDOW=8192
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048

